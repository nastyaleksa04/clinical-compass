# Скопируйте файл в .env и укажите ключ OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-flash
# Запасные модели через запятую: OpenRouter переключится на них, если основная недоступна (ошибка 429/503)
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME="Clinical Compass"
